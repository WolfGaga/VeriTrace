# Config-27B research profile
LLM_PROVIDER=dashscope
SILICON_MODEL=qwen3.5-27b
SEARCHER_MODEL=qwen3.5-27b
COGNITIVE_MODEL=qwen3.5-27b
READER_MODEL=qwen3.5-35b-a3b
PREFILTER_MODEL=qwen3.5-35b-a3b
WRITER_MODEL=qwen3.5-27b
WRITER_PROVIDER=dashscope
OUTLINE_MODEL=qwen3.5-27b
SECTION_PLANNER_MODEL=qwen3.5-27b
SECTION_WRITER_MODEL=qwen3.5-27b

SEARCH_ENGINE=serper
# Keep these budgets fixed for the supplied paper profile.
PLANNER_MAX_TURN=20
SEARCH_MAX_TURN=6
SEARCH_MAX_RESULTS=10
# Optional Planner syntax/access checks and copied task queries; not an OS sandbox.
PLANNER_ISOLATION=false
LLM_MAX_CONCURRENCY=35
PREFILTER_BATCH_SIZE=12
PREFILTER_MAX_WORKERS=4
READER_MAX_WORKERS=15
READER_MAX_CONTENT_LENGTH=15000
PDF_MAX_PAGES=20
SOFT_DEADLINE_MINUTES=70
ENABLE_PAGE_OCR=false
# Credentials stay in the untracked .env file.
DASHSCOPE_API_KEY=
DASHSCOPE_BACKUP_API_KEYS=
SERPER_API_KEY=
SERPER_BACKUP_API_KEYS=
JINA_API_KEY=
# Optional image OCR; required only when ENABLE_PAGE_OCR=true.
SILICONFLOW_API_KEY=

# Optional evaluation provider (OpenAI-compatible endpoint or Google API key).
GEMINI_BASE_URL=
GEMINI_API_KEY=
RACE_MODEL=gemini-2.5-pro
FACT_MODEL=gemini-2.5-flash
